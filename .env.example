# Copy to .env.local for local dev: cp .env.example .env.local
# Local Supabase testing: see docs/local-supabase.md for ports and credentials.
#
# DB TARGET — pick ONE:
#   - LOCAL (default dev/test): use the 127.0.0.1:54422 DATABASE_URL + local keys below.
#     Requires `supabase start`. E2E + unit tests run against LOCAL.
#   - CLOUD (staging/prod): comment out the local block, uncomment the cloud block,
#     point at db.<project-ref>.supabase.co. Never mix: migrations apply to ONE target.

# ── Local Supabase (Docker, `supabase start`) ─────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# anon (publishable) key — `supabase status` → API URL anon key. Needed for
# client-side Supabase reads (e.g. public testimonials/landing).
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status

# ── Cloud Supabase (alternative to local) ─────────────────────────────────
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Verifies Clerk webhook signatures at /api/webhooks/clerk. Get from
# Clerk Dashboard → Webhooks → Signing Secret. Required in all envs.
CLERK_WEBHOOK_SECRET=whsec_xxx
RESEND_API_KEY=re_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: when set, /api/cron/auto-assign requires
# `Authorization: Bearer <CRON_SECRET>`. Generate with `openssl rand -hex 32`
# and set the same value in the scheduler (Vercel Cron / external).
# Leave empty locally — the route is open without it (dev only).
#
# E2E only (never set in production): when =1, middleware + API routes accept
# the `user_role` cookie as identity (see src/lib/test-auth.ts). The
# playwright webServer sets this automatically.
CRON_SECRET=
